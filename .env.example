# Salin ke .env sebelum menjalankan infra:
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml --env-file .env up -d
#
# .env tidak boleh di-commit (lihat .gitignore).

# --- MinIO (object store) ---
MINIO_ROOT_USER=dsic2604
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_8_CHARS
MINIO_BUCKET=dsic2604
MINIO_ENDPOINT=http://minio:9000

# --- Iceberg REST catalog ---
ICEBERG_WAREHOUSE=s3://dsic2604/warehouse
ICEBERG_CATALOG_URI=http://iceberg-rest:8181

# --- Trino ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=dsic2604
TRINO_CATALOG=iceberg
TRINO_SCHEMA=dsic2604

# --- Resource caps (dibekukan sebelum main run, lihat G7) ---
BENCH_CPUS=8
BENCH_MEMORY=16g
TRINO_CPUS=6
TRINO_MEMORY=10g
MINIO_CPUS=2
MINIO_MEMORY=4g

# --- Reproducibility ---
BENCH_SEED=42
